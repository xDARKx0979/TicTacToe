rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Allow users to read/write their own profile only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Survey Results: Allow any authenticated user to update the aggregate count,
    // and any authenticated user to read it (admin page JS filters access).
    // For better security, restrict read access using custom claims or a known admin UID.
    match /surveyResults/aggregate {
      allow read, update: if request.auth != null;
      // Allow create only if it doesn't exist yet (first vote)
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/surveyResults/aggregate);
    }
  }
} 