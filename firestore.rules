rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Allow users to read/write their own profile only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Note: Consider if you need other fields here, like isAdmin? 
      // Or maybe store user profile info like display name?
    }

    // Chat Sessions: Store metadata about chats
    match /chat_sessions/{userId} {
       // Allow user to create their session info initially
       allow create: if request.auth != null && request.auth.uid == userId;
       // Allow user and admin to update (e.g., last message timestamp)
       allow update: if request.auth != null && 
                     (request.auth.uid == userId || request.auth.uid == 'II9Ifc2Cu1Mc2ExdoR8k4v5Uhyy2');
       // Allow admin to read all sessions for the list view
       allow read: if request.auth != null && request.auth.uid == 'II9Ifc2Cu1Mc2ExdoR8k4v5Uhyy2';
    }
    
    // Chat Messages: Store actual messages within a user's chat
    match /chats/{userId}/messages/{messageId} {
      // Allow user to read/write messages in their own chat
      // Allow admin to read/write messages in ANY chat
      allow read, write: if request.auth != null && 
                           (request.auth.uid == userId || request.auth.uid == 'II9Ifc2Cu1Mc2ExdoR8k4v5Uhyy2');
      
      // Optional: Add validation for message content/structure
      // allow write: if request.resource.data.text is string && 
      //                 request.resource.data.timestamp == request.time &&
      //                 request.resource.data.senderId == request.auth.uid &&
      //                 request.resource.data.keys().hasOnly(['text', 'timestamp', 'senderId', 'senderEmail', 'isAdmin']); 
    }

    // REMOVED Survey Results rules
    /* 
    match /surveyResults/aggregate {
      allow read: if request.auth != null && request.auth.uid == 'II9Ifc2Cu1Mc2ExdoR8k4v5Uhyy2'; // <<< RESTRICT READ TO ADMIN UID
      allow update: if request.auth != null; // Any logged-in user can increment
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/surveyResults/aggregate); // Can be created by first voter
    }
    */
  }
} 